# Copy this file to .env and fill in real values.
# NEVER commit .env — it's already in .gitignore.

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
MYSQL_AUTH_DB=goldenagro_auth
MYSQL_BUSINESS_DB=goldenagro_business

# ---------- JWT ----------
# MUST be identical in AuthService (issuer) and business-api (validator) — 32+ random chars.
# Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_RANDOM
JWT_ISSUER=GoldenAgroAuth
JWT_AUDIENCE=GoldenAgroAPI

# ---------- Domains / CORS ----------
# The public URL your frontend is served from — used for CORS on both APIs.
FRONTEND_ORIGIN=https://yourdomain.com
# Public API base URLs the frontend will call (through nginx reverse proxy)
VITE_AUTH_API_URL=https://yourdomain.com/auth-api
VITE_BUSINESS_API_URL=https://yourdomain.com/api

# ---------- business-api (Spring) ----------
# "update" auto-creates/updates tables on boot — fine to launch with, but there's
# no Flyway/Liquibase migration tooling in this project yet (Phase 2 item).
# Once your schema is stable, switch this to "validate" so accidental schema
# drift can't silently alter production data.
DDL_AUTO=update
SHOW_SQL=false

LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
